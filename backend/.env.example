# Copy to .env — NEVER commit real values
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/majismart
JWT_SECRET=change-me-to-64-random-chars-minimum
FRONTEND_URL=http://localhost:5173

# M-Pesa Daraja (leave empty for simulation mode with local 20-digit tokens)
MPESA_MODE=simulation
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-backend.onrender.com/api/payments/mpesa-callback
MPESA_CALLBACK_SECRET=change-me-callback-secret

# SMS via Africa's Talking (optional; logs to console when empty)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=MAJISMART

# Tariff: KES per litre billed (0.125 = KES 2.50 per 20L jerrican)
TARIFF_KES_PER_LITRE=0.125

# Web3 / Celo (optional)
CELO_RPC_URL=
MAJI_TOKEN_ADDRESS=
WATER_PAYMENT_ADDRESS=
WATER_ORACLE_ADDRESS=
WATER_DAO_ADDRESS=

# Demo data: seed demo users/nodes on EMPTY databases only (default true).
# Set false once real operational data exists — fixtures never mix with prod.
SEED_DEMO=true

# Guaranteed login accounts (reset each boot unless disabled).
# Set strong values in production, or DISABLE_BOOTSTRAP_ACCOUNTS=true
# once real staff accounts exist.
DISABLE_BOOTSTRAP_ACCOUNTS=false
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_COUNTY_PASSWORD=
BOOTSTRAP_OPERATOR_PASSWORD=
BOOTSTRAP_CITIZEN_PASSWORD=

# Optional Claude upgrade for the Maji support assistant (else local brain)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
